  "add_new_project": {
    "steps": [
      "1. 复制 _template/ 目录到 projects/<new-id>/",
      "2. 编辑 projects/<new-id>/index.json 填入项目元数据",
      "3. 在 _index/projects.json 的 projects 数组中添加新条目",
      "4. （可选）配置 cron 任务",
      "5. 重新部署 _site/ 知识库浏览器"
    ]
  },
